<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_irpf_audit_line_form" model="ir.ui.view">
        <field name="name">account.irpf.audit.line.form</field>
        <field name="model">account.irpf.audit.line</field>
        <field name="arch" type="xml">
            <form string="Client Audit Details">
                <header>
                    <button name="action_print_report" type="object" string="Print Report" class="btn-secondary"/>
                    <button name="action_send_manual_email" type="object" string="Send Email" class="btn-primary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Invoices</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="period" readonly="1"/>
                        </group>
                        <group>
                            <field name="amount_odoo" readonly="1"/>
                            <field name="amount_aeat"/>
                            <field name="difference" readonly="1"/>
                        </group>
                        <group>
                            <field name="agreement_status" readonly="1"/>
                            <field name="response_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="disagreement_reason" readonly="1"
                                   invisible="agreement_status != 'disagreed'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
