<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_irpf_audit_form" model="ir.ui.view">
        <field name="name">account.irpf.audit.form</field>
        <field name="model">account.irpf.audit</field>
        <field name="arch" type="xml">
            <form string="IRPF Annual &amp; Quarterly Audit">
                <header>
                    <button name="action_calculate" string="Calculate Audit" type="object" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_open_import_wizard" string="Import AEAT Data" type="object"
                            class="btn-secondary" invisible="state == 'draft' or period != 'annual'"/>
                    <button name="action_send_notifications" string="Notify Clients" type="object" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <button name="action_close_audit"
                            string="Close Audit"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'calculated'"/>
                    <button name="action_draft"
                            string="Reset to Draft"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'draft'"
                            confirm="Are you sure you want to reset? This will delete all calculated lines."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="fiscal_year"/>
                            <field name="period" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Client Details" name="lines">
                            <field name="line_ids" readonly="state == 'done'">
                                <list editable="bottom"
                                      decoration-info="state == 'info'"
                                      decoration-muted="state == 'pending'"
                                      decoration-danger="state == 'discrepancy'"
                                      decoration-success="state == 'matched'">
                                    <field name="partner_id" readonly="1"/>
                                    <field name="amount_odoo" readonly="1" sum="Total Odoo"/>
                                    <field name="amount_aeat" sum="Total AEAT"
                                           column_invisible="parent.period != 'annual'"/>
                                    <field name="difference" sum="Total Diff"
                                           column_invisible="parent.period != 'annual'"
                                           decoration-danger="difference != 0"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'info'"
                                           decoration-warning="state == 'pending'"
                                           decoration-danger="state == 'discrepancy'"
                                           decoration-success="state == 'matched'"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="period" column_invisible="True"/>

                                    <button name="action_print_report" type="object" icon="fa-print"
                                            title="Print Report" aria-label="Print Report"/>
                                    <button name="action_send_manual_email" type="object" icon="fa-envelope"
                                            title="Send Email" aria-label="Send Email"/>
                                    <button name="action_open_line" type="object" icon="fa-external-link"
                                            title="Open Details" aria-label="Open Details"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_account_irpf_audit" model="ir.actions.act_window">
        <field name="name">IRPF Annual Audit</field>
        <field name="res_model">account.irpf.audit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_irpf_audit_root" name="IRPF Audit" parent="account.menu_finance_reports"
              action="action_account_irpf_audit" sequence="200"/>
</odoo>
